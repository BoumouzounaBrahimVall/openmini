{
  "name": "@openmini/cli",
  "version": "0.0.0",
  "description": "OpenMini CLI: create, dev, build, pack, publish, inspect",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev-host": {
      "types": "./dist/dev-host/browser-host.d.ts",
      "import": "./dist/dev-host/browser-host.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@openmini/conformance": "workspace:*",
    "@aws-sdk/client-s3": "^3.1116.0"
  },
  "dependencies": {
    "@openmini/runtime": "workspace:*",
    "@vitejs/plugin-react": "^4.5.0",
    "ajv": "^8.17.0",
    "commander": "^15.0.0",
    "vite": "^6.3.0",
    "fflate": "^0.8.2"
  },
  "bin": {
    "mini": "./dist/bin.js"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoumouzounaBrahimVall/openmini.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/BoumouzounaBrahimVall/openmini#readme",
  "bugs": "https://github.com/BoumouzounaBrahimVall/openmini/issues",
  "keywords": [
    "mini-apps",
    "super-app",
    "webview",
    "micro-frontend",
    "ota",
    "cli",
    "static-registry"
  ]
}
