  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@openmini/cli": "workspace:*",
    "@openmini/conformance": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/node": "^22.10.0",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "@types/react": "^19.2.18"
  },
  "dependencies": {
    "@openmini/runtime": "workspace:*",
    "fflate": "^0.8.2",
    "zod": "^4.1.0"
  },
