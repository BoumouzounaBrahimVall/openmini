{
  "name": "@openmini/runtime",
  "version": "0.0.0",
  "description": "OpenMini mini-app runtime: typed bridge client, lifecycle, and the mini.* API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@openmini/conformance": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoumouzounaBrahimVall/openmini.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/BoumouzounaBrahimVall/openmini#readme",
  "bugs": "https://github.com/BoumouzounaBrahimVall/openmini/issues",
  "keywords": [
    "mini-apps",
    "super-app",
    "webview",
    "micro-frontend",
    "ota",
    "bridge",
    "mini-app-sdk"
  ]
}
